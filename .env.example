# Core API access
OPENAI_API_KEY=
NOTION_TOKEN=

# Spotify contract-first refresh
# Base Spotify refresh only needs the Spotify vars in this section.
# Notion vars below are optional post-write helpers.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_NAME=
SPOTIFY_PLAYLIST_ID=
SPOTIFY_ENABLE_URI_AUTOSYNC=false

# Main Notion databases
NOTION_DATABASE_ID=
NOTION_DATABASE_NAME=Opus Dei
NOTION_SAINT_DATABASE_ID=
NOTION_SAINT_DATABASE_NAME=Liturgical Calendar

# Daily novena generation
OAI_API_BASE_URL=https://api.openai.com/v1
OAI_MODEL=gpt-4.1-mini
ROMCAL_CALENDAR=general_roman
ROMCAL_LOCALE=en
ROMCAL_WINDOW_DAYS=9
# Shared runtime timezone override
JOB_UTC_OFFSET=-06:00
NOTION_TITLE_PROPERTY=Name
NOTION_NOVENA_ROW_TITLE=Daily Novenas from Liturgical Calendar
NOTION_NOVENA_PROPERTY=
NOTION_WRITE_DAILY_NOVENA_PAGE=false
NOTION_SAINT_RADAR_ENABLED=true
NOTION_SAINT_TITLE_PROPERTY=Name
NOTION_SAINT_FEAST_DAY_PROPERTY=Feast Day
NOTION_SAINT_CELEBRATION_PROPERTY=Celebration Rank
NOTION_SAINT_PRECEDENCE_PROPERTY=Precedence
NOTION_SAINT_BACKGROUND_PROPERTY=Background
NOTION_SAINT_INCLUDE_CALENDAR_DAYS=false
NOTION_SAINT_REFRESH_ALL=false

# Novena audio render/cache settings
NOVENA_AUDIO_ENABLED=true
NOVENA_AUDIO_MODEL=gpt-4o-mini-tts
NOVENA_AUDIO_VOICE=alloy
NOVENA_AUDIO_FORMAT=mp3
NOVENA_AUDIO_SPEED=1.0
NOVENA_AUDIO_CAPTION=Daily Novena Prayer (Audio)
NOVENA_AUDIO_FAIL_OPEN=true
NOVENA_AUDIO_LIBRARY_DIR=
NOTION_AUDIO_RENDER_HASH_PROPERTY=Render Hash
NOTION_AUDIO_SAVED_PROPERTY=Audio Saved

# Daily readings mirror
USCCB_READINGS_ENABLED=true
USCCB_READINGS_FAIL_OPEN=true
USCCB_READINGS_BASE_URL=https://bible.usccb.org/bible/readings
USCCB_READINGS_EXTRA_PAGE_IDS=

# Auto page audio
NOTION_AUDIO_PLATFORM_VALUE=auto-audio,auto-text
NOTION_AUDIO_CONFIG_PROPERTY=Audio Configuration
NOTION_AUDIO_RESOLVER_PROPERTY=Spotify Resolver
NOTION_TEXT_RESOLVER_PROPERTY=Text Resolver
NOTION_AUTO_AUDIO_RESOLVER_PRIMARY_PROPERTY=Auto Audio Resolver 1
NOTION_AUTO_AUDIO_RESOLVER_SECONDARY_PROPERTY=Auto Audio Resolver 2
NOTION_AUDIO_ENABLED_PROPERTY=Enabled
NOTION_PAGE_AUDIO_CONFIG_DATABASE_ID=
NOTION_PAGE_AUDIO_CONFIG_DATABASE_NAME=Page Audio Configuration
NOTION_AUDIO_FRAGMENTS_DATABASE_ID=
NOTION_AUDIO_FRAGMENTS_DATABASE_NAME=Audio Fragments
NOTION_AUDIO_OUTPUTS_DATABASE_ID=
NOTION_AUDIO_OUTPUTS_DATABASE_NAME=Audio Outputs
PAGE_AUDIO_CONFIG_FILE=config/page_audio_config.json
PAGE_AUDIO_CACHE_DIR=.cache/page_audio
PAGE_AUDIO_LIBRARY_DIR=
PAGE_AUDIO_CONFIG_KEY=
PAGE_AUDIO_ROW_TITLE=
PAGE_AUDIO_FAIL_OPEN=false
